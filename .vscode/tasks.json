{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "ForgePilot: 构建客户端",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", ".\\scripts\\Build-Client.cmd"],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "ForgePilot: 构建并启动",
            "dependsOn": "ForgePilot: 构建客户端",
            "type": "process",
            "command": "${workspaceFolder}/agent.venv/Scripts/python.exe",
            "args": ["${workspaceFolder}/agent/desktop.py"],
            "problemMatcher": []
        },
        {
            "label": "ForgePilot: 停止",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", ".\\Stop-ForgePilot.cmd"],
            "problemMatcher": []
        }
    ]
}
