      "id": "real-bug-01",
      "kind": "bug",
      "title": "Preserve unknown short options in unmatched arguments",
      "repository_url": "https://github.com/jarro2783/cxxopts",
      "license": "MIT",
      "license_file": "LICENSE",
      "base_commit": "a150450486700ae28a44f0667cf83f65de2d258b",
      "issue_url": "https://github.com/jarro2783/cxxopts/issues/312",
      "init_script": "real_tasks/init/init_repository.py",
      "task_spec": {
        "request": "When unrecognised options are allowed, a single-letter unknown short flag such as -z is silently lost from ParseResult::unmatched(). Keep it in the unmatched arguments in command-line order. Add a regression test using the project's existing test conventions. The preexisting assertion in test/options.cpp that encodes the old, incorrect unmatched() result may be corrected to the new expected result; preserve every other existing assertion and test control flow.",
        "acceptance_criteria": ["Unknown short and long options remain in unmatched() in their input order.", "Existing parser tests and the protected behavioral check pass."],
        "allowed_files": ["include/cxxopts.hpp", "test/options.cpp"],
        "required_changed": ["include/cxxopts.hpp", "test/options.cpp"],
        "integrity_policy": {"editable_existing_test_files": ["test/options.cpp"], "assertion_updates": [{"path": "test/options.cpp", "baseline_file_sha256": "e56bfbf3c944a7b7126614cba0152916fbf7b68e7963e9002f7b5138b07e042a", "old_assertion_sha256": "70d23badaef0125aaea6bd507615d5f1b737963cda9d746f39f0f327d7a8a36f", "new_assertion_sha256": "7206d232a15df39acf888ff655d4535e5683222c0a6d6e751a91c1415b56db50"}], "preserve_ctest_names": true, "minimum_ctest_cases": 1},
        "validation_commands": [
          ["cmake", "-S", ".", "-B", "{build_dir}", "-DCMAKE_POLICY_VERSION_MINIMUM=3.5", "-DCXXOPTS_BUILD_EXAMPLES=OFF", "-DCXXOPTS_BUILD_TESTS=ON"],
          ["cmake", "--build", "{build_dir}", "--config", "Debug"],
          ["ctest", "--test-dir", "{build_dir}", "-C", "Debug", "--output-on-failure"]
        ]
      },
      "protected_oracle": "real_tasks/protected_oracles/bug_unmatched_short.py"
    },
