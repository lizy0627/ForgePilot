{
  "$defs": {
    "ChangeSet": {
      "additionalProperties": false,
      "properties": {
        "execution_plan_artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Execution Plan Artifact Id",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/ChangedFile"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "requires_additional_approval": {
          "default": false,
          "title": "Requires Additional Approval",
          "type": "boolean"
        },
        "summary": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "execution_plan_artifact_id",
        "files",
        "summary"
      ],
      "title": "ChangeSet",
      "type": "object"
    },
    "ChangedFile": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria_ids": {
          "items": {
            "maxLength": 32,
            "pattern": "^[A-Z][A-Z0-9]*-[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Acceptance Criteria Ids",
          "type": "array"
        },
        "after_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Sha256"
        },
        "before_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Sha256"
        },
        "change_type": {
          "enum": [
            "added",
            "modified",
            "deleted"
          ],
          "title": "Change Type",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "plan_step_ids": {
          "items": {
            "maxLength": 32,
            "pattern": "^[A-Z][A-Z0-9]*-[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Plan Step Ids",
          "type": "array"
        },
        "test_change": {
          "default": "none",
          "enum": [
            "none",
            "new_test",
            "existing_test",
            "production_and_test"
          ],
          "title": "Test Change",
          "type": "string"
        },
        "unified_diff": {
          "maxLength": 1048576,
          "minLength": 1,
          "title": "Unified Diff",
          "type": "string"
        }
      },
      "required": [
        "path",
        "change_type",
        "unified_diff",
        "plan_step_ids",
        "acceptance_criteria_ids"
      ],
      "title": "ChangedFile",
      "type": "object"
    }
  },
  "$id": "https://forgepilot.local/schemas/artifact-changeset.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "ChangeSet",
      "default": "ChangeSet",
      "title": "Artifact Type",
      "type": "string"
    },
    "content": {
      "$ref": "#/$defs/ChangeSet"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "maxLength": 64,
      "title": "Created At",
      "type": "string"
    },
    "parent_artifact_ids": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Parent Artifact Ids",
      "type": "array"
    },
    "producer": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Producer",
      "type": "string"
    },
    "producer_node": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Producer Node",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "task_id",
    "producer",
    "producer_node",
    "created_at",
    "content_sha256",
    "content"
  ],
  "title": "ChangeSetArtifact",
  "type": "object"
}
