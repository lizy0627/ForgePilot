{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 32,
          "pattern": "^[A-Z][A-Z0-9]*-[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "verification": {
          "enum": [
            "build",
            "test",
            "ctest",
            "protected_test",
            "static_analysis",
            "inspection",
            "manual"
          ],
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "verification"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "AllowedScope": {
      "additionalProperties": false,
      "properties": {
        "max_changed_files": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Changed Files",
          "type": "integer"
        },
        "path_patterns": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Path Patterns",
          "type": "array"
        }
      },
      "required": [
        "path_patterns",
        "max_changed_files"
      ],
      "title": "AllowedScope",
      "type": "object"
    },
    "ChangeSet": {
      "additionalProperties": false,
      "properties": {
        "execution_plan_artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Execution Plan Artifact Id",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/ChangedFile"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "requires_additional_approval": {
          "default": false,
          "title": "Requires Additional Approval",
          "type": "boolean"
        },
        "summary": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "execution_plan_artifact_id",
        "files",
        "summary"
      ],
      "title": "ChangeSet",
      "type": "object"
    },
    "ChangeSetArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "const": "ChangeSet",
          "default": "ChangeSet",
          "title": "Artifact Type",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/ChangeSet"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "created_at": {
          "maxLength": 64,
          "title": "Created At",
          "type": "string"
        },
        "parent_artifact_ids": {
          "default": [],
