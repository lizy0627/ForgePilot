        "artifact_id",
        "task_id",
        "producer",
        "producer_node",
        "created_at",
        "content_sha256",
        "content"
      ],
      "title": "ChangeSetArtifact",
      "type": "object"
    },
    "ChangedFile": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria_ids": {
          "items": {
            "maxLength": 32,
            "pattern": "^[A-Z][A-Z0-9]*-[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Acceptance Criteria Ids",
          "type": "array"
        },
        "after_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Sha256"
        },
        "before_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Sha256"
        },
        "change_type": {
          "enum": [
            "added",
            "modified",
            "deleted"
          ],
          "title": "Change Type",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "plan_step_ids": {
          "items": {
            "maxLength": 32,
            "pattern": "^[A-Z][A-Z0-9]*-[1-9][0-9]*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Plan Step Ids",
          "type": "array"
        },
        "test_change": {
          "default": "none",
          "enum": [
            "none",
            "new_test",
            "existing_test",
            "production_and_test"
          ],
          "title": "Test Change",
          "type": "string"
        },
        "unified_diff": {
          "maxLength": 1048576,
          "minLength": 1,
          "title": "Unified Diff",
          "type": "string"
        }
      },
      "required": [
        "path",
        "change_type",
        "unified_diff",
        "plan_step_ids",
        "acceptance_criteria_ids"
      ],
      "title": "ChangedFile",
      "type": "object"
    },
    "CommandResult": {
      "additionalProperties": false,
      "properties": {
        "command_summary": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Command Summary",
          "type": "string"
        },
        "exit_code": {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "title": "Exit Code",
          "type": "integer"
        },
        "finished_at": {
          "maxLength": 64,
          "title": "Finished At",
          "type": "string"
        },
        "kind": {
          "enum": [
            "configure",
            "build",
            "test",
            "protected_test",
            "integrity",
            "custom"
