{
  "$defs": {
    "EvidenceBundle": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "summary": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "items",
        "summary"
      ],
      "title": "EvidenceBundle",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "evidence_id": {
          "maxLength": 32,
          "pattern": "^EV-[1-9][0-9]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "file_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Hash"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "reason": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "enum": [
            "local_repository",
            "rag",
            "external",
            "user",
            "approved_mcp",
            "tool_output"
          ],
          "title": "Source",
          "type": "string"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "evidence_id",
        "claim",
        "source",
        "confidence",
        "reason"
      ],
      "title": "EvidenceItem",
      "type": "object"
    }
  },
  "$id": "https://forgepilot.local/schemas/artifact-evidencebundle.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "EvidenceBundle",
      "default": "EvidenceBundle",
      "title": "Artifact Type",
      "type": "string"
    },
    "content": {
      "$ref": "#/$defs/EvidenceBundle"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "created_at": {
      "maxLength": 64,
      "title": "Created At",
      "type": "string"
    },
    "parent_artifact_ids": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Parent Artifact Ids",
      "type": "array"
    },
    "producer": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Producer",
      "type": "string"
    },
    "producer_node": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Producer Node",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "task_id",
    "producer",
    "producer_node",
    "created_at",
    "content_sha256",
    "content"
  ],
  "title": "EvidenceBundleArtifact",
  "type": "object"
}
